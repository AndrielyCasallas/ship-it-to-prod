# Copy this file to .env for local Docker Compose execution.
# Never commit the real .env file.

BOT_TOKEN=
SUPERUSER_TELEGRAM_ID=0
DATABASE_URL=sqlite:////app/data/community.db
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=local-community-api-key-change-me
CORS_ORIGINS=http://localhost:3000

# NEXT_PUBLIC_* values are embedded into the browser bundle and are not secrets.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_KEY=local-community-api-key-change-me
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_MEETUP_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Optional image names for pulling from GHCR instead of using local images.
BACKEND_IMAGE=community-backend:local
FRONTEND_IMAGE=community-frontend:local